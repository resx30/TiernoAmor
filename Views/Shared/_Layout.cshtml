@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tierno Amor</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark sticky-top" id="navbarPrincipal">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-cup-hot-fill me-1"></i> Tierno Amor
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navMenu">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
                        <li class="nav-item">
                            <a class="nav-link @(ctrl == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ctrl == "Menu" ? "active" : "")" asp-controller="Menu" asp-action="Index">Menú</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ctrl == "Pedidos" ? "active" : "")" asp-controller="Pedidos" asp-action="Index">Pedidos</a>
                        </li>
                        <li class="nav-item ms-lg-2">
                            <a class="btn btn-rosa btn-sm" asp-controller="Pedidos" asp-action="Crear">
                                <i class="bi bi-bag-heart me-1"></i> Hacer pedido
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <footer class="footer-tierno mt-5">
        <div class="container py-4">
            <div class="row g-4">
                <div class="col-md-4">
                    <h5 class="footer-titulo">Tierno Amor</h5>
                    <p class="mb-0 small">Café, panadería y postres hechos con cariño.</p>
                </div>
                <div class="col-md-4">
                    <h6 class="footer-titulo">Contacto</h6>
                    <p class="mb-1 small"><i class="bi bi-geo-alt me-2"></i>Calle Principal 123, Envigado</p>
                    <p class="mb-1 small"><i class="bi bi-telephone me-2"></i>+57 123 456 7890</p>
                    <p class="mb-0 small"><i class="bi bi-envelope me-2"></i>tiernamorocafeteria@gmail.com</p>
                </div>
                <div class="col-md-4">
                    <h6 class="footer-titulo">Horario</h6>
                    <p class="mb-1 small">Lunes a viernes: 8:00 AM - 8:00 PM</p>
                    <p class="mb-0 small">Sábados y domingos: 9:00 AM - 6:00 PM</p>
                </div>
            </div>
            <hr class="footer-linea">
            <p class="text-center small mb-0">© @DateTime.Now.Year Cafetería Tierno Amor · Seguimiento 03 · ASP.NET Core MVC</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>