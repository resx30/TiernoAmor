@model List<TiernoAmor.Models.Pedido>
@{ ViewData["Title"] = "Pedidos"; }

<h2>Pedidos recibidos</h2>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

<a asp-action="Crear" class="btn btn-tierno mb-3">Nuevo pedido</a>

@if (!Model.Any())
{
    <p class="text-muted">Aún no hay pedidos.</p>
}
else
{
    <div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr><th>#</th><th>Cliente</th><th>Producto</th><th>Tamaño</th><th>Cant.</th><th>Llevar</th><th>Descuento</th><th>Total</th><th>Fecha</th></tr>
        </thead>
        <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Id</td>
                <td>@p.NombreCliente</td>
                <td>@p.ProductoNombre</td>
                <td>@p.Tamano</td>
                <td>@p.Cantidad</td>
                <td>@(p.ParaLlevar ? "Sí" : "No")</td>
                <td>@p.Descuento.ToString("C0")</td>
                <td><strong>@p.Total.ToString("C0")</strong></td>
                <td>@p.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
            </tr>
        }
        </tbody>
    </table>
    </div>
}